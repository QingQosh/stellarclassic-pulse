# =============================================================================
# Production Environment — terraform.tfvars.example
# SorobanPulse (Issue #650)
#
# Copy to terraform.tfvars and fill in real values before applying.
# NEVER commit terraform.tfvars — it may contain sensitive data.
# =============================================================================

aws_region   = "us-east-1"
environment  = "production"
project_name = "soroban-pulse"

# ---------------------------------------------------------------------------
# Networking — 3 AZs for HA
# ---------------------------------------------------------------------------
vpc_cidr             = "10.1.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_subnet_cidrs  = ["10.1.1.0/24", "10.1.2.0/24", "10.1.3.0/24"]
private_subnet_cidrs = ["10.1.11.0/24", "10.1.12.0/24", "10.1.13.0/24"]
enable_nat_gateway   = true
single_nat_gateway   = false  # One NAT per AZ for HA

# ---------------------------------------------------------------------------
# RDS — production-grade instance
# ---------------------------------------------------------------------------
db_instance_class              = "db.r6g.large"
db_engine_version              = "16.3"
db_name                        = "soroban_pulse"
db_username                    = "soroban_admin"
db_allocated_storage           = 100
db_max_allocated_storage       = 500
db_backup_retention_period     = 14
db_multi_az                    = true
db_deletion_protection         = true
db_apply_immediately           = false
db_skip_final_snapshot         = false
db_performance_insights_enabled = true
db_monitoring_interval         = 60

# ---------------------------------------------------------------------------
# ALB
# ---------------------------------------------------------------------------
alb_internal            = false
alb_access_logs_enabled = true
alb_idle_timeout        = 60
health_check_path       = "/healthz/ready"
health_check_interval   = 30
health_check_threshold  = 2
app_port                = 3000
app_container_count     = 3

# Replace with a real ACM certificate ARN before applying:
# certificate_arn = "arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/CERT_ID"

# ---------------------------------------------------------------------------
# Monitoring — tighter thresholds in production
# ---------------------------------------------------------------------------
# alarm_actions_arn = ["arn:aws:sns:us-east-1:ACCOUNT_ID:pagerduty-soroban-pulse"]
# ok_actions_arn    = ["arn:aws:sns:us-east-1:ACCOUNT_ID:pagerduty-soroban-pulse"]

rds_cpu_alarm_threshold     = 80
rds_storage_alarm_threshold = 10737418240  # 10 GiB
alb_5xx_alarm_threshold     = 10
alb_latency_alarm_threshold = 1.0
log_retention_days          = 90
